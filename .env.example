DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Long random string (e.g. `openssl rand -base64 48`). Required in production.
JWT_SECRET="replace-with-a-long-random-string"
FRONTEND_ORIGIN="http://localhost:3000"
# Public base URL of this API — used for uploaded-file links stored in the database.
PUBLIC_API_URL="http://localhost:3001/api"
PORT=3001
# Only used by `npm run prisma:seed` (first admin) and `npm run admin:set` (reset).
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-long-password"
